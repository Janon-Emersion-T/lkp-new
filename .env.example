# LKProfessionals environment template
# Copy to .env for local development. Never commit .env.

# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key
DJANGO_DEBUG=true
ALLOWED_HOSTS=127.0.0.1,localhost,testserver
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8118,http://localhost:8118
TIME_ZONE=Asia/Colombo
PUBLIC_SITE_URL=http://127.0.0.1:8118

# PostgreSQL
POSTGRES_DB=lkprofessionals
POSTGRES_USER=lkprofessionals
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60

# Email
DEFAULT_FROM_EMAIL=hello@lkprofessionals.com
SERVER_EMAIL=hello@lkprofessionals.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT=20

# Reverse proxy / production security
USE_X_FORWARDED_HOST=true
SECURE_SSL_REDIRECT=false
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
CSRF_COOKIE_HTTPONLY=false
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false
X_FRAME_OPTIONS=DENY

# Production example values:
# DJANGO_DEBUG=false
# ALLOWED_HOSTS=lkprofessionals.com,www.lkprofessionals.com
# CSRF_TRUSTED_ORIGINS=https://lkprofessionals.com,https://www.lkprofessionals.com
# PUBLIC_SITE_URL=https://lkprofessionals.com
# SECURE_SSL_REDIRECT=true
# SESSION_COOKIE_SECURE=true
# CSRF_COOKIE_SECURE=true
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=true
# SECURE_HSTS_PRELOAD=true
